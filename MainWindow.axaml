<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtualMan.MainWindow"
        Title="BioSim: Whole-Body Physiological Model v3.2"
        Width="1360" Height="800" MinWidth="1100" MinHeight="680"
        Background="#141923" Foreground="#E1E4E8">

  <Window.Styles>
    <Style Selector="Menu > MenuItem">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#A0AEC0"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="MenuItem MenuItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto, *, Auto">

    <!-- TOP MENUBAR & SYSTEM STATUS -->
    <Border Grid.Row="0" Background="#1A202C" Padding="6,2" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto, *, Auto">

        <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center">
          <MenuItem Header="FILE">
            <MenuItem Header="Save Session..." Click="OnSaveSession"/>
            <MenuItem Header="Load Session..." Click="OnLoadSession"/>
            <Separator/>
            <MenuItem Header="Export Telemetry Log..." Click="OnExportLog"/>
            <MenuItem Header="Export Vitals History (CSV)..." Click="OnExportCsv"/>
            <Separator/>
            <MenuItem Header="Exit" Click="OnExit"/>
          </MenuItem>

          <MenuItem Header="VIEW">
            <MenuItem x:Name="MenuLines" Header="Leader Lines" Click="OnToggleLines"/>
            <MenuItem x:Name="MenuCards" Header="System Status Cards" Click="OnToggleCards"/>
            <MenuItem x:Name="MenuLog" Header="Telemetry Log" Click="OnToggleLog"/>
            <MenuItem x:Name="MenuEcg" Header="ECG Monitor" Click="OnToggleEcg"/>
            <Separator/>
            <MenuItem Header="Clear Telemetry Log" Click="OnClearLog"/>
          </MenuItem>

          <MenuItem Header="SIMULATION">
            <MenuItem x:Name="MenuSimToggle" Header="Pause" Click="OnToggleRun"/>
            <MenuItem Header="Step (+5 s)" Click="OnStepClicked"/>
            <MenuItem Header="Reset" Click="OnResetClicked"/>
            <Separator/>
            <MenuItem x:Name="SpeedMenu" Header="Speed"/>
          </MenuItem>

          <MenuItem Header="FAULT MODEL">
            <MenuItem x:Name="FaultOrgansMenu" Header="Inject Fault Into Organ"/>
            <MenuItem x:Name="ScenarioMenu" Header="Clinical Scenarios"/>
            <MenuItem Header="Random Fault" Click="OnRandomFault"/>
            <Separator/>
            <MenuItem Header="Restore All Organs" Click="OnRestoreAll"/>
          </MenuItem>

          <MenuItem Header="HOSPITAL">
            <MenuItem Header="Open Hospital Window..." Click="OnOpenHospital"/>
            <Separator/>
            <MenuItem x:Name="CaseMenu" Header="Start Patient Case"/>
            <MenuItem x:Name="DiseaseMenu" Header="Inject Disease"/>
            <MenuItem x:Name="PharmacyMenu" Header="Give Medicine"/>
            <MenuItem x:Name="TestsMenu" Header="Order Test"/>
            <MenuItem x:Name="ProceduresMenu" Header="Procedures"/>
          </MenuItem>

          <MenuItem Header="ANALYTICS">
            <MenuItem Header="Live Charts..." Click="OnOpenAnalytics"/>
            <MenuItem Header="Organ Summary Report..." Click="OnOpenReport"/>
            <MenuItem Header="Organ Dependency Map..." Click="OnOpenDependencyMap"/>
            <MenuItem Header="Export Vitals History (CSV)..." Click="OnExportCsv"/>
          </MenuItem>

          <MenuItem Header="HELP">
            <MenuItem Header="Keyboard Shortcuts..." Click="OnHelpShortcuts"/>
            <MenuItem Header="How The Model Works..." Click="OnHelpModel"/>
            <MenuItem Header="About BioSim..." Click="OnAbout"/>
          </MenuItem>
        </Menu>

        <TextBlock Grid.Column="1" x:Name="TopStatusBanner" Text="" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#48BB78" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="SessionText" FontSize="11" Foreground="#CBD5E0"/>
          <TextBlock x:Name="ClockText" FontSize="11" Foreground="#8B949E"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- MAIN 4-COLUMN WORKSPACE -->
    <Grid x:Name="WorkGrid" Grid.Row="1" ColumnDefinitions="290, 190, *, 360" Margin="10">

      <!-- COLUMN 1: MODULAR SYSTEM STATUS CARDS (built from the model) -->
      <Border x:Name="CardsPanel" Grid.Column="0" Background="#1B222D" CornerRadius="6" Padding="10" Margin="0,0,8,0" BorderBrush="#2D3748" BorderThickness="1">
        <Grid RowDefinitions="Auto, *">
          <TextBlock Grid.Row="0" Text="MODULAR SYSTEM STATUS" FontSize="12" FontWeight="Bold" Foreground="#E1E4E8" Margin="0,0,0,10"/>
          <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="SystemCardsContainer" Spacing="8"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- COLUMN 2: SYSTEM LAYERS + SIMULATION PARAMETERS -->
      <Border Grid.Column="1" Background="#1B222D" CornerRadius="6" Padding="10" Margin="0,0,8,0" BorderBrush="#2D3748" BorderThickness="1">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="SYSTEM LAYERS" FontSize="12" FontWeight="Bold" Foreground="#E1E4E8"/>
            <Border Background="#252D3B" CornerRadius="4" Padding="8">
              <StackPanel x:Name="LayersPanel" Spacing="8"/>
            </Border>

            <TextBlock Text="Parameters" FontSize="12" FontWeight="Bold" Foreground="#E1E4E8" Margin="0,15,0,0"/>
            <ComboBox x:Name="ParamSelector" Width="165" PlaceholderText="Select Parameter"/>
            <TextBlock x:Name="ParamValueLabel" Text="Value" FontSize="11" Foreground="#A0AEC0" Margin="0,5,0,0"/>
            <ComboBox x:Name="ParamValueSelector" Width="165" IsEnabled="False"/>
            <TextBlock x:Name="ParamEffectText" FontSize="10" Foreground="#718096" TextWrapping="Wrap" Width="165"/>
            <Border Background="#252D3B" CornerRadius="4" Padding="8" Margin="0,6,0,0">
              <TextBlock x:Name="ParamSummaryText" FontSize="10.5" Foreground="#CBD5E0" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="ACTIVE TREATMENT" FontSize="12" FontWeight="Bold" Foreground="#E1E4E8" Margin="0,15,0,0"/>
            <Border Background="#252D3B" CornerRadius="4" Padding="8">
              <TextBlock x:Name="ActiveText" FontSize="10.5" Foreground="#CBD5E0" TextWrapping="Wrap" Width="150"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- COLUMN 3: BODY MAP. The Viewbox scales the canvas so the body and every line stay aligned.
           Leader lines, dots and callout buttons are added in code from the model. -->
      <Border Grid.Column="2" Background="#1B222D" CornerRadius="6" Padding="10" Margin="0,0,8,0" BorderBrush="#2D3748" BorderThickness="1">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Canvas x:Name="AvatarCanvas" Width="640" Height="610">
            <Image Canvas.Left="201" Canvas.Top="20" Width="237" Height="560"
                   Stretch="Uniform" Source="avares://VirtualMan/Assets/body_only.png"/>
            <TextBlock x:Name="AvatarGaitText" Canvas.Left="20" Canvas.Top="588" FontSize="11" FontWeight="Bold" Foreground="#CBD5E0"/>
          </Canvas>
        </Viewbox>
      </Border>

      <!-- COLUMN 4: TELEMETRY LOG + ECG / VITALS -->
      <Grid Grid.Column="3" RowDefinitions="*, Auto">

        <Border x:Name="LogPanel" Grid.Row="0" Background="#1B222D" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#2D3748" BorderThickness="1">
          <Grid RowDefinitions="Auto, Auto, *">
            <TextBlock Grid.Row="0" Text="FAULT-INJECTION &amp; TELEMETRY LOG" FontSize="12" FontWeight="Bold" Foreground="#E1E4E8" Margin="0,0,0,8"/>
            <TextBox x:Name="LogFilter" Grid.Row="1" Watermark="Filter..." Height="28" Margin="0,0,0,8" Background="#141923" Foreground="White" FontSize="11"/>
            <ScrollViewer Grid.Row="2">
              <StackPanel x:Name="LogContainer" Spacing="4"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border x:Name="EcgPanel" Grid.Row="1" Background="#1B222D" CornerRadius="6" Padding="10" BorderBrush="#2D3748" BorderThickness="1">
          <StackPanel Spacing="4">
            <TextBlock x:Name="EcgTitle" FontSize="11" FontWeight="Bold" Foreground="#E1E4E8"/>
            <TextBlock x:Name="VitalsLine1" FontSize="10.5" Foreground="#CBD5E0"/>
            <TextBlock x:Name="VitalsLine2" FontSize="10.5" Foreground="#A0AEC0"/>
            <TextBlock x:Name="VitalsLine3" FontSize="10.5" Foreground="#A0AEC0"/>
            <Border x:Name="EcgHost" Height="95" Background="#141923" ClipToBounds="True"/>
          </StackPanel>
        </Border>

      </Grid>
    </Grid>

    <!-- BOTTOM PLAYBACK & TIMELINE BAR -->
    <Border Grid.Row="2" Background="#1A202C" Padding="12,8" BorderBrush="#2D3748" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
        <Button x:Name="BtnPlay" Grid.Column="0" Content="▶ PLAY" Click="OnPlayClicked" Background="#2B6CB0" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,6,0"/>
        <Button x:Name="BtnPause" Grid.Column="1" Content="|| PAUSE" Click="OnPauseClicked" Background="#2D3748" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,6,0"/>
        <Button x:Name="BtnStep" Grid.Column="2" Content="▶| STEP" Click="OnStepClicked" Background="#2D3748" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,6,0"/>
        <Button x:Name="BtnReset" Grid.Column="3" Content="⟲ RESET" Click="OnResetClicked" Background="#C53030" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,15,0"/>

        <Grid Grid.Column="4" ColumnDefinitions="Auto, *" VerticalAlignment="Center" Margin="0,0,15,0">
          <TextBlock x:Name="TimeText" Grid.Column="0" FontSize="11" FontWeight="Bold" Foreground="#A0AEC0" VerticalAlignment="Center" MinWidth="110"/>
          <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="SIMULATION SPEED" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center"/>
          <ComboBox x:Name="SpeedBox" MinWidth="80"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
