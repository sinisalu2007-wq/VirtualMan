<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>VirtualMan</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\body_only.png" />
    <AvaloniaResource Include="Assets\body_only.png" />
  </ItemGroup>

  <!-- Old prototype code that the new BioSim engine replaces. Excluded from the build, not deleted. -->
  <ItemGroup>
    <Compile Remove="Engine.cs" />
    <Compile Remove="VirtualPerson.cs" />
    <Compile Remove="Core\**" />
    <Compile Remove="Interfaces\**" />
    <Compile Remove="Systems\**" />
  </ItemGroup>

</Project>
